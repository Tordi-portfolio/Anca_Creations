# Copy these into your hosting provider's environment settings (or export them locally).
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=www.yourdomain.com,yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.yourdomain.com,https://yourdomain.com
# Optional: shown in the footer and contact page if set
BRAND_EMAIL=
